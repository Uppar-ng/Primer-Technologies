{
  "version": 2,
  "name": "zaure",
  "alias": ["zauretech.xyz", "www.zauretech.xyz"],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/alamin-ahmed", "destination": "/alamin-ahmed.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/categories", "destination": "/categories.html" },
    { "source": "/category", "destination": "/category.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/detail", "destination": "/detail.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/favorites", "destination": "/favorites.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/post", "destination": "/post.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/safety", "destination": "/safety.html" },
    { "source": "/search", "destination": "/search.html" },
    { "source": "/service", "destination": "/service.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/stores", "destination": "/stores.html" },
    { "source": "/store", "destination": "/store.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/service.html", "destination": "/service", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://mobsted.com https://*.mobsted.com"
        },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(), camera=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}